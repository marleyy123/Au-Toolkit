
{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/midtrans.js": { "maxDuration": 60 },
    "api/midtrans-webhook.js": { "maxDuration": 60 },
    "api/verify-buyer.js": { "maxDuration": 60 },
    "api/lynk-webhook.js": { "maxDuration": 60 },
    "api/sheet-admin.js": { "maxDuration": 60 },
    "api/ios-auth-debug.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

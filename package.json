    "browser-image-compression": "^2.0.2",
    "cropperjs": "^1.6.2",
    "dotenv": "^17.2.3",
    "emoji-datasource-apple": "^16.0.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "2.4.5",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
